# COMMS environment. Copy to .env.local (git-ignored). Never commit real keys.

# live (default) | hybrid | demo
#   live   - Robinhood registry/prices/corporate actions + Robinhood Chain reads. Unverifiable checks are UNKNOWN.
#   hybrid - live data; checks no live source can supply are filled with values badged DEMO.
#   demo   - built-in simulated dataset, labelled DEMO MODE everywhere.
NEXT_PUBLIC_DATA_MODE=live

# Optional overrides (server-side only)
# ROBINHOOD_API_BASE=https://api.robinhood.com/rhj
# RH_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# BLOCKSCOUT_API_BASE=https://robinhoodchain.blockscout.com/api/v2

# Optional providers. Read only by COMMS API routes; never sent to the browser. Do NOT prefix with NEXT_PUBLIC_.
# COINGECKO_API_KEY=
# ALPHA_VANTAGE_API_KEY=
