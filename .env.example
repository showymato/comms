# COMMS environment. Copy to .env.local (git-ignored). Never commit real keys.

# live (default) | hybrid | demo
#   live   - Robinhood registry/prices/corporate actions + Robinhood Chain reads. Unverifiable checks are UNKNOWN.
#   hybrid - live data; checks no live source can supply are filled with values badged DEMO.
#   demo   - built-in simulated dataset, labelled DEMO ENVIRONMENT everywhere.
NEXT_PUBLIC_DATA_MODE=live

# Wallet — WalletConnect / Reown project id (https://cloud.reown.com).
# Empty: WalletConnect and mobile wallets are disabled and the UI says "Wallet connection configuration required".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public site URL (metadata / OG). Optional.
# NEXT_PUBLIC_SITE_URL=https://comms.example

# Robinhood Chain RPC used by COMMS server routes (private; never sent to the browser).
# Empty = public RPC. Paste a full provider URL (Alchemy, QuickNode, Chainstack, …) including its key for production.
ROBINHOOD_RPC_URL=
# Optional RPC for browser wallet reads. NEXT_PUBLIC values ship to the browser: use a domain-restricted key.
# NEXT_PUBLIC_RH_RPC_URL=

# Optional providers. Read only by COMMS API routes; never sent to the browser. Do NOT prefix with NEXT_PUBLIC_.
COINGECKO_API_KEY=
ALPHA_VANTAGE_API_KEY=
BLOCKSCOUT_API_URL=
# ROBINHOOD_API_BASE=https://api.robinhood.com/rhj

# Base URL shown in developer docs and used by the SDK examples.
COMMS_API_URL=
